# Copy this file to .env for local development.
# Never commit .env or put real credentials in this example file.

# Optional. If SECRET_KEY is not set, the app creates a random key in
# instance/secret_key on first start and reuses it.
# Use at least 32 random characters. This example value is public, so the app
# ignores it and uses instance/secret_key instead.
# SECRET_KEY=replace-with-a-long-random-local-secret

# Set to 1 only while developing: enables auto-reload and the interactive
# error debugger (never on a shared network).
# FLASK_DEBUG=0
# Optional. Default: instance/face_attendance.db. Note: a relative SQLite path
# is resolved INSIDE the instance/ folder, so write sqlite:///face_attendance.db,
# not sqlite:///instance/face_attendance.db (that would point to instance/instance/).
# DATABASE_URL=sqlite:///face_attendance.db
ORGANIZATION_TIMEZONE=Asia/Kolkata

# Sign-in and sessions (defaults shown).
# SESSION_IDLE_MINUTES=30
# KIOSK_SESSION_IDLE_MINUTES=720
# SESSION_MAX_HOURS=12
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# PASSWORD_MIN_LENGTH=10

# Face enrolment (defaults shown). Lower the quality limits slightly if good
# photos are rejected in your lighting; never store biometrics inside app/static.
# BIOMETRIC_STORAGE_PATH=instance/biometrics
# ENROLLMENT_MIN_SAMPLES=3
# ENROLLMENT_MAX_SAMPLES=10
# ENROLLMENT_MIN_FACE_WIDTH=120
# ENROLLMENT_MIN_SHARPNESS=45
# ENROLLMENT_MIN_BRIGHTNESS=45
# ENROLLMENT_MAX_BRIGHTNESS=215
# ENROLLMENT_MIN_CONTRAST=18

# Consent notice version. Change it only when the notice text changes; employees
# who consented to an older version must consent again.
# CONSENT_NOTICE_VERSION=portfolio-v2

# Face recognition (Phase 3, defaults shown). Thresholds are NOT calibrated.
# RECOGNITION_MODEL_DIR=instance/models
# RECOGNITION_MATCH_THRESHOLD=0.45
# RECOGNITION_AMBIGUITY_MARGIN=0.05
# RECOGNITION_DETECTION_SCORE=0.9

# Model files are downloaded separately (see Setup in README.md) and never committed.
