# Copy this file to .env for local development.
# Never commit .env or put real credentials in this example file.

SECRET_KEY=replace-with-a-long-random-local-secret
DATABASE_URL=sqlite:///instance/face_attendance.db
ORGANIZATION_TIMEZONE=Asia/Kolkata

# Face enrolment (defaults shown). Lower the quality limits slightly if good
# photos are rejected in your lighting; never store biometrics inside app/static.
# BIOMETRIC_STORAGE_PATH=instance/biometrics
# ENROLLMENT_MIN_SAMPLES=3
# ENROLLMENT_MAX_SAMPLES=10
# ENROLLMENT_MIN_FACE_WIDTH=120
# ENROLLMENT_MIN_SHARPNESS=45
# ENROLLMENT_MIN_BRIGHTNESS=45
# ENROLLMENT_MAX_BRIGHTNESS=215
# ENROLLMENT_MIN_CONTRAST=18

# Model paths and camera configuration are intentionally omitted until their
# separate licence, download, and implementation approvals are complete.